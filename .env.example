# Copy to .env and fill in. Used by docker compose and by `next dev`.
# Never commit .env.

# --- Database ---
# Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Web ---
# Where the Next.js app forwards /api requests. Read when the site runs.
# On Render, API_HOSTPORT (host:port) is set for you instead.
API_URL=http://localhost:4010
# Optional. A header the host sets with the visitor's address, for rate limits.
# Without it, the first address in X-Forwarded-For is used.
CLIENT_IP_HEADER=
# The address people open in a browser. Links in emails point here.
WEB_URL=http://localhost:3230
# Shown on the Contact page and in the policies. Payment companies require one.
CONTACT_EMAIL=

# --- First administrator ---
# Created at startup while no administrator exists.
# They must choose a new password at first sign-in.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# --- Documents ---
# Encrypts bills and IDs before they are stored. 32 random bytes in base64.
# Make one with: openssl rand -base64 32
# Back this up. Without it, stored documents cannot be read.
EVIDENCE_ENCRYPTION_KEY=
# Leave the bucket empty to keep documents on local disk.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Patvero ---
# Used by the API only, never by the browser. The key is a read-only
# Patvero Developer API key made for Faceless Angels alone
# (Patvero > Workspace > Developer API). Paste the pv_live_ value into
# .env yourself; it is shown once. Scopes: workspace.read, meetings.read.
# Without a key, pasted meeting links are still checked through Patvero's
# public lookup.
PATVERO_API_BASE_URL=https://api.patvero.com/api/v1
PATVERO_API_KEY=

# --- Giving ---
# Gifts that support Faceless Angels. Stripe takes US dollars, Paystack takes
# naira. Keys stay on the API server. Use test keys (sk_test_) until the legal
# body is settled: live keys (sk_live_) are refused unless GIVING_LIVE=true.
GIVING_LIVE=false
STRIPE_SECRET_KEY=
# From Stripe > Developers > Webhooks, for https://<site>/api/giving/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Paystack signs its webhooks with this same key.
# Webhook address: https://<site>/api/giving/webhooks/paystack
PAYSTACK_SECRET_KEY=
# Optional. Printed at the end of every receipt.
GIVING_RECEIPT_NOTE=

# --- Email ---
# relykit, smtp, or log (log prints emails instead of sending them).
EMAIL_PROVIDER=log
MAIL_FROM=
RELYKIT_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
